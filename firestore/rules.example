rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(imei) {
      return signedIn() && imei in userDoc().linkedImeis;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /devices/{imei} {
      allow read: if linkedTo(imei);
      // Gateway (Admin SDK) owns device telemetry. Clients may only rename.
      allow update: if linkedTo(imei)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt']);
      allow create, delete: if false;

      match /locations/{locationId} {
        allow read: if linkedTo(imei);
        allow write: if false;
      }
    }

    match /geofences/{geofenceId} {
      allow read: if linkedTo(resource.data.imei);
      allow create: if signedIn()
        && linkedTo(request.resource.data.imei)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if linkedTo(resource.data.imei)
        && resource.data.createdBy == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow read: if linkedTo(resource.data.imei);
      allow update: if linkedTo(resource.data.imei)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'resolvedAt']);
      // App "Send help alert" — gateway still owns device-originated alerts.
      allow create: if linkedTo(request.resource.data.imei)
        && request.resource.data.type == 'sos'
        && request.resource.data.severity == 'critical'
        && request.resource.data.resolved == false
        && request.resource.data.notifyStatus == 'pending'
        && request.resource.data.keys()
            .hasOnly(['imei', 'type', 'severity', 'message', 'resolved',
                      'payload', 'createdAt', 'notifyStatus']);
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || (resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /notificationLogs/{logId} {
      allow read: if linkedTo(resource.data.imei);
      allow write: if false; // gateway Admin SDK only
    }
  }
}
