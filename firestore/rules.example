rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(imei) {
      return sharedWith(imei, 'owner');
    }

    function managedWatch(imei) {
      return exists(/databases/$(database)/documents/familyServices/$(imei));
    }
    function familyService(imei) {
      return get(/databases/$(database)/documents/familyServices/$(imei)).data;
    }
    function familyActive(sub) {
      return sub.get('version', 0) == 1
        && sub.get('managedBy', '') in ['guardian_admin', 'billing', 'migration']
        && sub.get('plan', '') in ['family', 'care']
        && ((sub.get('status', '') == 'active'
              && (sub.get('currentPeriodEnd', null) == null || sub.currentPeriodEnd > request.time))
          || (sub.get('status', '') == 'trialing' && sub.get('trialEndsAt', request.time) > request.time)
          || (sub.get('status', '') in ['grace_period', 'past_due'] && sub.get('graceEndsAt', request.time) > request.time)
          || (sub.get('status', '') == 'cancelled' && sub.get('currentPeriodEnd', request.time) > request.time));
    }
    function familyMember(imei) {
      let circle = familyService(imei);
      let member = circle.get('members', {}).get(request.auth.uid, {});
      return member.get('status', '') == 'active'
        && (member.get('untilMs', null) == null || member.untilMs > request.time.toMillis());
    }
    function sharedWith(imei, permission) {
      return signedIn() && (
        (!managedWatch(imei) && imei in userDoc().get('linkedImeis', []))
        || (managedWatch(imei) && familyMember(imei)
          && familyActive(familyService(imei).subscription)
          && (familyService(imei).ownerUid == request.auth.uid
            || familyService(imei).members[request.auth.uid].get('permissions', {}).get(permission, false) == true))
      );
    }
    function watchPlanAtLeast(imei, requiredPlan) {
      return (!managedWatch(imei) && activePlanAtLeast(requiredPlan))
        || (managedWatch(imei) && familyActive(familyService(imei).subscription)
          && (requiredPlan != 'care' || familyService(imei).subscription.plan == 'care'));
    }
    // Index fields help the UI choose streams; only the service document grants access.
    match /familyServices/{imei} {
      allow get: if signedIn() && familyMember(imei);
      allow list, write: if false;
      match /usage/{month} { allow get: if signedIn() && familyMember(imei); allow list, write: if false; }
    }
    match /familyDeviceViews/{imei} {
      allow read: if sharedWith(imei, 'location');
      allow write: if false;
    }
    match /familyDeviceProfiles/{imei} {
      allow get: if signedIn() && managedWatch(imei) && familyMember(imei)
        && familyActive(familyService(imei).subscription);
      allow list, write: if false;
    }
    match /familyInvites/{id} { allow read, write: if false; }
    match /familyChannels/{id} { allow read, write: if false; }
    match /familyLinkCodes/{id} { allow read, write: if false; }
    match /familyNumbers/{id} { allow read, write: if false; }
    match /familyAnswers/{id} { allow read, write: if false; }
    match /familyNotices/{id} { allow read, write: if false; }
    match /familyAcknowledgements/{id} { allow read, write: if false; }
    match /familyDeliveries/{id} { allow read, write: if false; }

    function effectiveServiceOwnerUid() {
      return userDoc().get('serviceOwnerUid', request.auth.uid);
    }

    function verifiedServiceMember(ownerUid) {
      return signedIn()
        && effectiveServiceOwnerUid() == ownerUid
        && (
          request.auth.uid == ownerUid
          || request.auth.uid in get(
            /databases/$(database)/documents/users/$(ownerUid)
          ).data.get('memberUids', [])
        );
    }

    function serviceSubscription() {
      return get(
        /databases/$(database)/documents/serviceSubscriptions/$(effectiveServiceOwnerUid())
      ).data;
    }

    function trustedActiveSubscription() {
      let ownerUid = effectiveServiceOwnerUid();
      let sub = serviceSubscription();
      return verifiedServiceMember(ownerUid)
        && sub.get('version', 0) == 1
        && sub.get('managedBy', '') in ['guardian_admin', 'billing', 'migration']
        && sub.get('plan', '') in ['essential', 'family', 'care']
        && (
          (sub.get('status', '') == 'active'
            && (!('currentPeriodEnd' in sub)
              || sub.currentPeriodEnd == null
              || sub.currentPeriodEnd > request.time))
          || (sub.get('status', '') == 'trialing'
            && sub.get('trialEndsAt', request.time) > request.time)
          || (sub.get('status', '') in ['grace_period', 'past_due']
            && sub.get('graceEndsAt', request.time) > request.time)
          || (sub.get('status', '') == 'cancelled'
            && sub.get('currentPeriodEnd', request.time) > request.time)
        );
    }

    function activePlanAtLeast(requiredPlan) {
      let plan = serviceSubscription().get('plan', '');
      return trustedActiveSubscription()
        && (
          requiredPlan == 'essential'
          || (requiredPlan == 'family' && plan in ['family', 'care'])
          || (requiredPlan == 'care' && plan == 'care')
        );
    }

    // Retention envelopes are deliberately expressed relative to request.time
    // because Firestore's rules evaluator cannot reliably execute timezone
    // calendar methods. They cover the app's Mauritius-day query bounds with
    // a small boundary margin.
    function wellnessHistoryAllowed(imei, recordedAt) {
      let plan = managedWatch(imei) ? familyService(imei).subscription.plan : serviceSubscription().get('plan', '');
      return recordedAt is timestamp
        && recordedAt <= request.time
        && watchPlanAtLeast(imei, 'essential')
        && (plan == 'care'
          || (plan == 'family'
            && recordedAt >= request.time - duration.value(169, 'h'))
          || (plan == 'essential'
            && recordedAt >= request.time - duration.value(25, 'h')));
    }

    function wellnessQueryUpperAllowed(recordedAt) {
      return recordedAt is timestamp
        && recordedAt < request.time + duration.value(26, 'h');
    }

    function activeWellbeingConsent(imei) {
      let consent = get(
        /databases/$(database)/documents/wellbeingConsents/$(imei)
      ).data;
      return consent.get('version', 0) == 1
        && consent.get('status', '') == 'granted'
        && consent.get('managedBy', '') in ['guardian_admin', 'migration']
        && consent.wearerAcknowledgedAt is timestamp
        && consent.wearerAcknowledgedAt <= request.time
        && (
          !('expiresAt' in consent)
          || consent.expiresAt == null
          || consent.expiresAt > request.time
        )
        && (
          !('revokedAt' in consent)
          || consent.revokedAt == null
        );
    }

    function caregiverLimit() {
      return serviceSubscription().get('plan', '') == 'essential' ? 1 : 5;
    }

    function historyAllowed(imei, recordedAt) {
      // Family and Care have retained history, so their collection queries do
      // not need a per-document time predicate. Essential remains restricted
      // to records inside its seven-day window.
      return watchPlanAtLeast(imei, 'family')
        || (
          watchPlanAtLeast(imei, 'essential')
          && recordedAt is timestamp
          && recordedAt >= request.time - duration.value(7, 'd')
        );
    }

    function validUserAvatar() {
      return !('avatarUrl' in request.resource.data)
        || request.resource.data.avatarUrl == null
        || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.size() <= 2048);
    }

    function doesNotMutateServiceAuthority() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'subscription',
          'serviceOwnerUid',
          'memberUids',
          'familyMembers', 'familyServiceImeis', 'familyAccess'
        ]);
    }

    function validNewUserAuthorityFields() {
      return !request.resource.data.keys()
          .hasAny(['subscription', 'serviceOwnerUid', 'memberUids', 'familyServiceImeis', 'familyAccess'])
        && (
          !('familyMembers' in request.resource.data)
          || (request.resource.data.familyMembers is list
              && request.resource.data.familyMembers.size() == 0)
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validNewUserAuthorityFields();
      allow update: if signedIn()
        && request.auth.uid == uid
        && validUserAvatar()
        && doesNotMutateServiceAuthority();
      allow delete: if false;
    }

    // Backend-owned source of truth for Essential / Family / Care. The app
    // may display only its verified effective family plan. Admin SDK billing,
    // migration and support tools bypass these client rules for writes.
    match /serviceSubscriptions/{ownerUid} {
      allow read: if verifiedServiceMember(ownerUid);
      allow create, update, delete: if false;
    }

    match /devices/{imei} {
      allow read: if linkedTo(imei);
      // Gateway (Admin SDK) owns telemetry. Clients may identify the wearer,
      // set the wearable's SIM number (used for calls / SMS commands), and
      // cache the last fall-detection / location-reporting-interval
      // preference they asked the pendant for (V46/V48/V52 only -- the
      // device has no read-back command, so this is a request cache, not
      // confirmed device state; see commands.js).
      allow update: if sharedWith(imei, 'settings')
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['name', 'nickname', 'relationship', 'avatarUrl'])
            || (!managedWatch(imei) && linkedTo(imei)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['simNumber']) || linkedTo(imei))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'nickname',
              'relationship',
              'avatarUrl',
              'simNumber',
              'fallDetection',
              'watchAlertProfile',
              'locationReportingIntervalSeconds',
              'manualReportingIntervalSeconds',
              'locationReportingMode',
              'careProfile',
              'carePriorities',
              'updatedAt'
            ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['careProfile', 'carePriorities'])
          || watchPlanAtLeast(imei, 'care')
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['watchAlertProfile'])
          || watchPlanAtLeast(imei, 'family')
        );
      allow create, delete: if false;

      // Area weather for this profile. The gateway owns location selection,
      // provider credentials and freshness; clients cannot forge conditions.
      match /weather/{weatherId} {
        allow read: if weatherId == 'current' && sharedWith(imei, 'location');
        allow write: if false;
      }

      match /locations/{locationId} {
        allow read: if sharedWith(imei, 'history')
          && historyAllowed(imei, resource.data.recordedAt);
        allow write: if false;
      }

      match /segments/{segmentId} {
        allow read: if sharedWith(imei, 'history')
          && historyAllowed(imei, resource.data.from);
        allow write: if false;
      }

      match /journeys/{journeyId} {
        allow read: if sharedWith(imei, 'history')
          && historyAllowed(imei, resource.data.startAt);
        allow write: if false;

        match /presentations/{presentationId} {
          allow read: if sharedWith(imei, 'history')
            && historyAllowed(imei, resource.data.journeyStartAt)
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time;
          allow write: if false;
        }
      }

      // Family and Care customers may read consented watch estimates within
      // their edition's history window. The backend owns writes and wearing
      // remains unconfirmed.
      match /wellbeingReadings/{readingId} {
        allow get: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'family')
          && resource.data.get('displayable', false) == true
          && wellnessHistoryAllowed(imei, resource.data.get('observedAt', null))
          && activeWellbeingConsent(imei);
        // Queries are constrained to the edition's calendar window by the
        // query bounds. A list rule cannot additionally require <= request.time
        // because a valid full-day query ends at the next calendar boundary.
        allow list: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'family')
          && resource.data.displayable == true
          && (watchPlanAtLeast(imei, 'care')
            || resource.data.observedAt >= request.time - duration.value(169, 'h'))
          && resource.data.observedAt < request.time + duration.value(26, 'h')
          && activeWellbeingConsent(imei);
        allow write: if false;
      }

      // Gateway-owned V52 daily activity. A client must be linked and hold an
      // active edition entitlement. The app only parses bounded display fields;
      // raw counter baselines remain backend-only by convention.
      // Wearing data quality is available on every active edition. Raw
      // tracker bits and diagnostic captures remain backend-only.
      match /wearStatus/{statusId} {
        allow read: if statusId == 'current' && sharedWith(imei, 'wellbeing') && watchPlanAtLeast(imei, 'essential');
        allow write: if false;
      }
      // Manual observations are separate from gateway-owned wearing evidence.
      // Require a current, server-acknowledged check; never accept queued old
      // checks, client eligibility fields or a forged recorder identity.
      match /wearChecks/{checkId} {
        function validCheck() {
          let data = request.resource.data;
          return checkId == 'current' && sharedWith(imei, 'wellbeing') && watchPlanAtLeast(imei, 'essential')
            && data.keys().hasOnly(['version', 'state', 'observedAt', 'recordedAt', 'recordedBy'])
            && data.version == 1 && data.state in ['worn', 'removed']
            && data.recordedBy == request.auth.uid
            && data.recordedAt == request.time
            && data.observedAt is timestamp
            && data.observedAt >= request.time - duration.value(60, 's')
            && data.observedAt <= request.time + duration.value(60, 's');
        }
        allow get: if checkId == 'current' && sharedWith(imei, 'wellbeing') && watchPlanAtLeast(imei, 'essential');
        allow create: if validCheck();
        allow update: if validCheck() && request.resource.data.observedAt >= resource.data.observedAt;
        allow list, delete: if false;
      }
      match /wellnessRoutine/{statusId} {
        allow get: if statusId == 'current' && sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'family');
        allow list, write: if false;
      }
      // Durable scheduler claims/counters are internal. The gateway copies
      // only bounded, reading-free status to wellnessRoutine/current.
      match /wellnessScheduleDays/{localDate} {
        allow read, write: if false;
      }
      match /wellnessScheduleSlots/{slotId} {
        allow read, write: if false;
      }
      match /wearDiagnostics/{captureId} {
        allow read, write: if false;
      }
      match /activityDays/{localDate} {
        allow get: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'essential')
          && resource.data.get('displayable', false) == true
          && wellnessHistoryAllowed(imei, resource.data.get('lastObservedAt', null));
        allow list: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'care')
          && resource.data.displayable == true
          && resource.data.lastObservedAt < request.time + duration.value(26, 'h');
        allow list: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'family')
          && resource.data.displayable == true
          && resource.data.lastObservedAt >= request.time - duration.value(169, 'h')
          && resource.data.lastObservedAt < request.time + duration.value(26, 'h');
        allow list: if sharedWith(imei, 'wellbeing')
          && watchPlanAtLeast(imei, 'essential')
          && resource.data.displayable == true
          && resource.data.lastObservedAt >= request.time - duration.value(25, 'h')
          && resource.data.lastObservedAt < request.time + duration.value(26, 'h');
        allow create, update, delete: if false;
      }
    }

    // Durable wearer-consent authority is backend-only. It must never be
    // readable or forgeable through a mobile/web client.
    match /wellbeingConsents/{imei} {
      allow read, write: if false;
    }

    // Desired settings only. The gateway separately checks current consent,
    // session, feature gates, account access and conditional uploads.
    match /wellnessRoutineRequests/{imei} {
      function validTime(time) {
        return time is string && time.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
      }
      function minuteOfDay(time) {
        return int(time[0:2]) * 60 + int(time[3:5]);
      }
      function spacedAfter(earlier, later) {
        return minuteOfDay(later) - minuteOfDay(earlier) >= 5;
      }
      function midnightGap(first, last) {
        return 1440 + minuteOfDay(first) - minuteOfDay(last) >= 5;
      }
      function validDailyTimes(data) {
        let times = data.times;
        return times is list && (
          (data.routine == 'manual' && times.size() == 0)
          || (data.routine == 'gentle' && times.size() == 2
            && validTime(times[0]) && validTime(times[1])
            && spacedAfter(times[0], times[1])
            && midnightGap(times[0], times[1]))
          || (data.routine == 'balanced' && times.size() == 3
            && validTime(times[0]) && validTime(times[1]) && validTime(times[2])
            && spacedAfter(times[0], times[1]) && spacedAfter(times[1], times[2])
            && midnightGap(times[0], times[2]))
        );
      }
      function validScheduleRequest() {
        let data = request.resource.data;
        return (
          (data.version == 2
            && data.keys().hasOnly(['version', 'routine', 'times', 'timeZone', 'requestedBy', 'updatedAt'])
            && data.timeZone == 'Indian/Mauritius'
            && validDailyTimes(data))
          // Older app versions can still stop. Never restart an interval
          // routine from a legacy request or infer daily times from it.
          || (data.version == 1 && data.routine == 'manual'
            && data.keys().hasOnly(['version', 'routine', 'requestedBy', 'updatedAt']))
        ) && data.requestedBy == request.auth.uid
          && data.updatedAt == request.time;
      }
      allow get: if sharedWith(imei, 'wellbeing') && watchPlanAtLeast(imei, 'family');
      allow create, update: if sharedWith(imei, 'wellbeing') && watchPlanAtLeast(imei, 'family')
        && validScheduleRequest()
        && (request.resource.data.routine == 'manual' || activeWellbeingConsent(imei));
      allow list, delete: if false;
    }

    // Private radio fingerprints and enrollment revisions are gateway-only.
    // The authenticated HTTP API exposes a selected label and fresh choices.
    match /homeWifiEnrollments/{imei} {
      allow read, write: if false;
    }

    match /geofences/{geofenceId} {
      allow read: if sharedWith(resource.data.imei, 'zones');
      allow create: if signedIn()
        && sharedWith(request.resource.data.imei, 'zones')
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if sharedWith(resource.data.imei, 'zones')
        && resource.data.createdBy == request.auth.uid;
    }

    match /medicationReminders/{reminderId} {
      allow read: if sharedWith(resource.data.imei, 'reminders')
        && watchPlanAtLeast(resource.data.imei, 'family');
      allow create: if signedIn()
        && !request.resource.data.keys().hasAny(['managed', 'slot', 'mode', 'version', 'durationMs', 'evidence'])
        && !exists(/databases/$(database)/documents/medicationVoiceDevices/$(request.resource.data.imei))
        && sharedWith(request.resource.data.imei, 'reminders')
        && watchPlanAtLeast(request.resource.data.imei, 'family')
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if sharedWith(resource.data.imei, 'reminders')
        && !resource.data.keys().hasAny(['managed'])
        && !request.resource.data.keys().hasAny(['managed', 'slot', 'mode', 'version', 'durationMs', 'evidence'])
        && request.resource.data.imei == resource.data.imei
        && request.resource.data.createdBy == resource.data.createdBy
        && !exists(/databases/$(database)/documents/medicationVoiceDevices/$(resource.data.imei))
        && watchPlanAtLeast(resource.data.imei, 'family')
        && resource.data.createdBy == request.auth.uid;
      allow delete: if sharedWith(resource.data.imei, 'reminders')
        && !resource.data.keys().hasAny(['managed'])
        && !exists(/databases/$(database)/documents/medicationVoiceDevices/$(resource.data.imei))
        && watchPlanAtLeast(resource.data.imei, 'family')
        && resource.data.createdBy == request.auth.uid;
    }

    // Audio and command evidence are served only by the authenticated gateway.
    match /medicationVoicePrivate/{id} { allow read, write: if false; }
    match /medicationVoiceDevices/{id} { allow read, write: if false; }
    match /medicationVoiceRequests/{id} { allow read, write: if false; }

    // Care routines use an audited request -> backend-owned canonical record
    // workflow. Clients can never author canonical state or audit evidence.
    match /careReminderRequests/{requestId} {
      allow create: if signedIn()
        && watchPlanAtLeast(request.resource.data.imei, 'care')
        && sharedWith(request.resource.data.imei, 'reminders')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.action in ['upsert', 'delete']
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'action',
          'imei',
          'requestedBy',
          'status',
          'createdAt',
          'scheduleId',
          'schedule'
        ])
        && request.resource.data.imei is string
        && request.resource.data.imei.size() == 15
        && request.resource.data.scheduleId is string
        && request.resource.data.scheduleId.size() >= 1
        && request.resource.data.scheduleId.size() <= 80
        && (
          request.resource.data.action == 'delete'
          || request.resource.data.schedule is map
        );
      allow read: if signedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /careReminderSchedules/{scheduleId} {
      allow read: if sharedWith(resource.data.imei, 'reminders')
        && watchPlanAtLeast(resource.data.imei, 'care')
        && resource.data.serviceOwnerUid == effectiveServiceOwnerUid();
      allow create, update, delete: if false;
    }

    match /careReminderAudit/{auditId} {
      allow read: if sharedWith(resource.data.imei, 'reminders')
        && watchPlanAtLeast(resource.data.imei, 'care')
        && resource.data.serviceOwnerUid == effectiveServiceOwnerUid();
      allow create, update, delete: if false;
    }

    match /safetySnapshotRequests/{requestId} {
      allow create: if signedIn()
        && watchPlanAtLeast(request.resource.data.imei, 'family')
        && sharedWith(request.resource.data.imei, 'photos')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.safetyPurposeConfirmed == true
        && request.resource.data.consentConfirmed == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'imei',
          'requestedBy',
          'status',
          'safetyPurposeConfirmed',
          'consentConfirmed',
          'purpose',
          'createdAt'
        ])
        && request.resource.data.imei is string
        && request.resource.data.imei.size() == 15
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() >= 8
        && request.resource.data.purpose.size() <= 240;
      allow read: if signedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Incident media and AI are available only through reauthorized HTTP reads.
    match /incidentPhotos/{id} { allow read, write: if false; }
    match /incidentPhotoSettings/{id} { allow read, write: if false; }
    match /incidentPhotoDelivery/{id} { allow read, write: if false; }

    match /safetySnapshotAuthorizations/{authorizationId} {
      allow read: if !('incidentId' in resource.data)
        && sharedWith(resource.data.imei, 'photos')
        && watchPlanAtLeast(resource.data.imei, 'family')
        && resource.data.serviceOwnerUid == effectiveServiceOwnerUid();
      allow create, update, delete: if false;
    }

    match /safetySnapshotAudit/{auditId} {
      allow read: if sharedWith(resource.data.imei, 'photos')
        && watchPlanAtLeast(resource.data.imei, 'family')
        && resource.data.serviceOwnerUid == effectiveServiceOwnerUid();
      allow create, update, delete: if false;
    }

    match /alerts/{alertId} {
      match /responses/{uid} {
        allow read: if sharedWith(get(/databases/$(database)/documents/alerts/$(alertId)).data.imei, 'alerts');
        allow write: if false;
      }
      allow read: if sharedWith(resource.data.imei, 'alerts');
      allow update: if sharedWith(resource.data.imei, 'alerts')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'resolvedAt']);
      // App "Send help alert" â€” gateway still owns device-originated alerts.
      allow create: if sharedWith(request.resource.data.imei, 'alerts')
        && request.resource.data.type == 'sos'
        && request.resource.data.severity == 'critical'
        && request.resource.data.resolved == false
        && request.resource.data.notifyStatus == 'pending'
        && request.resource.data.keys()
            .hasOnly(['imei', 'type', 'severity', 'message', 'resolved',
                      'payload', 'createdAt', 'notifyStatus']);
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && effectiveServiceOwnerUid() == request.auth.uid
        && activePlanAtLeast('essential')
        && userDoc().get('memberUids', []).size() < caregiverLimit()
        && request.resource.data.keys().hasOnly([
          'code',
          'createdBy',
          'createdByName',
          'createdByEmail',
          'status',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code == inviteId
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Joining a family is a backend-verified workflow. The requester may only
    // enqueue the code. The gateway validates expiry, active plan and caregiver
    // capacity before it writes serviceOwnerUid, memberUids or linked watches.
    match /familyJoinRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'requestedBy',
          'status',
          'createdAt'
        ])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if linkedTo(resource.data.imei);
      allow write: if false; // gateway Admin SDK only
    }

    // Phonebook authority and empty-slot inventory are operator-owned. A
    // notification contact or linked family viewer is not a contact manager.
    match /watchPhonebookPolicies/{imei} {
      allow read, write: if false;
    }
    match /watchPhonebookSettings/{imei} {
      allow read: if sharedWith(imei, 'settings');
      allow write: if false;
    }
    match /watchPhonebookRequests/{requestId} {
      allow read: if sharedWith(resource.data.imei, 'settings');
      allow create: if request.resource.data.keys().hasOnly([
          'imei', 'name', 'phone', 'requestedBy', 'createdAt', 'expiresAt', 'status', 'policyRevision'
        ])
        && requestId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.imei is string
        && request.resource.data.imei.matches('^[0-9]{15}$')
        && sharedWith(request.resource.data.imei, 'settings')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[+][1-9][0-9]{7,14}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(90, 's')
        && get(/databases/$(database)/documents/watchPhonebookPolicies/$(request.resource.data.imei)).data.version == 1
        && get(/databases/$(database)/documents/watchPhonebookPolicies/$(request.resource.data.imei)).data.managedBy == 'guardian_admin'
        && get(/databases/$(database)/documents/watchPhonebookPolicies/$(request.resource.data.imei)).data.managerUid == request.auth.uid
        && get(/databases/$(database)/documents/watchPhonebookPolicies/$(request.resource.data.imei)).data.revision == request.resource.data.policyRevision;
      allow update, delete: if false;
    }

    // Call authority and captured phone/frame data are backend-owned.
    // Emergency jobs and caller authority are never client writable. Client
    // alerts, including app SOS, cannot manufacture a watch callback window.
    match /watchEmergencyPolicies/{imei} { allow read, write: if false; }
    match /watchEmergencyJobs/{imei} { allow read, write: if false; }
    match /watchEmergencyEvents/{eventId} { allow read, write: if false; }
    match /watchEmergencySettings/{imei} {
      allow read: if sharedWith(imei, 'settings');
      allow write: if false;
    }
    match /watchEmergencyRequests/{requestId} {
      allow read: if sharedWith(resource.data.imei, 'settings');
      allow create: if request.resource.data.keys().hasOnly([
          'imei', 'enabled', 'requestedBy', 'revision', 'consentAccepted', 'createdAt', 'expiresAt', 'status'
        ])
        && requestId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.imei is string
        && request.resource.data.imei.matches('^[0-9]{15}$')
        && sharedWith(request.resource.data.imei, 'settings')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.enabled is bool
        && request.resource.data.consentAccepted == request.resource.data.enabled
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(90, 's')
        && get(/databases/$(database)/documents/watchEmergencyPolicies/$(request.resource.data.imei)).data.managerUid == request.auth.uid
        && get(/databases/$(database)/documents/watchEmergencyPolicies/$(request.resource.data.imei)).data.revision == request.resource.data.revision
        && (!request.resource.data.enabled || watchPlanAtLeast(request.resource.data.imei, 'family'));
      allow update, delete: if false;
    }

    // Bearer link records are backend-only; public access is through the
    // expiring, re-authorized gateway landing page, never Firestore clients.
    match /watchCallLinks/{linkId} { allow read, write: if false; }

    // Voice metadata and originals/PCM are served only by the re-authorizing
    // gateway. Clients cannot forge delivery results or fetch private audio.
    match /voiceMessages/{id} { allow read, write: if false; }
    match /voiceMessagePrivate/{id} { allow read, write: if false; }
    match /voiceMessageDevices/{id} { allow read, write: if false; }

    // AI reservations and evidence selections are backend-only. They contain
    // no raw prompt/media, and can never be edited to reset a spending ceiling.
    match /aiBudgetMonths/{id} { allow read, write: if false; }
    match /aiBudgetDays/{id} { allow read, write: if false; }
    match /aiAttempts/{id} { allow read, write: if false; }
    match /aiSelections/{id} { allow read, write: if false; }

    match /watchCallPolicies/{imei} {
      allow read, write: if false;
    }
    match /watchCallSettings/{imei} {
      allow read: if sharedWith(imei, 'settings');
      allow write: if false;
    }
    match /watchCallRequests/{requestId} {
      allow read: if sharedWith(resource.data.imei, 'settings');
      allow create: if request.resource.data.keys().hasOnly([
          'imei', 'mode', 'requestedBy', 'createdAt', 'expiresAt', 'status', 'consentAccepted', 'policyRevision'
        ])
        && requestId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.imei is string
        && request.resource.data.imei.matches('^[0-9]{15}$')
        && sharedWith(request.resource.data.imei, 'settings')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // Client-supplied deadline prevents offline queued Auto writes from
        // becoming fresh requests when serverTimestamp resolves on reconnect.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(90, 's')
        && get(/databases/$(database)/documents/watchCallPolicies/$(request.resource.data.imei)).data.version == 1
        && get(/databases/$(database)/documents/watchCallPolicies/$(request.resource.data.imei)).data.managedBy == 'guardian_admin'
        && request.resource.data.policyRevision == get(/databases/$(database)/documents/watchCallPolicies/$(request.resource.data.imei)).data.revision
        && (
          (request.resource.data.mode == 'manual' && request.resource.data.consentAccepted == false)
          || (request.resource.data.mode == 'auto'
            && request.resource.data.consentAccepted == true
            && watchPlanAtLeast(request.resource.data.imei, 'family')
            && get(/databases/$(database)/documents/watchCallPolicies/$(request.resource.data.imei)).data.autoEnabled == true)
        );
      allow update, delete: if false;
    }
    // Gateway-only newest-intent watermarks; clients cannot reset ordering.
    match /deviceCommandIntents/{intentId} {
      allow read, write: if false;
    }

    match /deviceCommands/{commandId} {
      allow read: if sharedWith(resource.data.imei, 'settings');
      allow create: if sharedWith(request.resource.data.imei, 'settings')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        // Phonebook additions use the dedicated authenticated request service;
        // generic commands cannot bypass its slot inventory or authority.
        && request.resource.data.get('type', '') != 'set_phonebook_contact'
        && request.resource.data.get('type', '') != 'set_alarm_mode'
        && request.resource.data.get('type', '') != 'set_watch_answer_mode'
        && (
          request.resource.data.get('type', '') != 'set_watch_alert_profile'
          || (
            request.resource.data.get('params', {}).keys().hasOnly(['mode'])
            && request.resource.data.params.get('mode', 0) in [1, 2, 3, 4]
            && watchPlanAtLeast(request.resource.data.imei, 'family')
          )
        )
        && (
          request.resource.data.get('type', '') != 'set_medication_reminder'
          || (watchPlanAtLeast(request.resource.data.imei, 'family')
            && !exists(/databases/$(database)/documents/medicationVoiceDevices/$(request.resource.data.imei)))
        );
      allow update, delete: if false; // gateway Admin SDK only
    }
  }
}
