rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(imei) {
      return signedIn() && imei in userDoc().linkedImeis;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Bring-up: any signed-in guardian can read all devices/alerts.
    // Tighten to linkedTo(imei) before production.
    match /devices/{imei} {
      allow read: if signedIn();
      allow write: if false; // gateway (Admin SDK) only

      match /locations/{locationId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'resolvedAt']);
      allow create, delete: if false;
    }
  }
}
