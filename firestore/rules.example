rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(imei) {
      return signedIn() && imei in userDoc().linkedImeis;
    }

    function effectiveServiceOwnerUid() {
      return userDoc().get('serviceOwnerUid', request.auth.uid);
    }

    function verifiedServiceMember(ownerUid) {
      return signedIn()
        && effectiveServiceOwnerUid() == ownerUid
        && (
          request.auth.uid == ownerUid
          || request.auth.uid in get(
            /databases/$(database)/documents/users/$(ownerUid)
          ).data.get('memberUids', [])
        );
    }

    function serviceSubscription() {
      return get(
        /databases/$(database)/documents/serviceSubscriptions/$(effectiveServiceOwnerUid())
      ).data;
    }

    function trustedActiveSubscription() {
      let ownerUid = effectiveServiceOwnerUid();
      let sub = serviceSubscription();
      return verifiedServiceMember(ownerUid)
        && sub.get('version', 0) == 1
        && sub.get('managedBy', '') in ['guardian_admin', 'billing', 'migration']
        && sub.get('plan', '') in ['essential', 'family', 'care']
        && (
          (sub.get('status', '') == 'active'
            && (!('currentPeriodEnd' in sub)
              || sub.currentPeriodEnd == null
              || sub.currentPeriodEnd > request.time))
          || (sub.get('status', '') == 'trialing'
            && sub.get('trialEndsAt', request.time) > request.time)
          || (sub.get('status', '') in ['grace_period', 'past_due']
            && sub.get('graceEndsAt', request.time) > request.time)
          || (sub.get('status', '') == 'cancelled'
            && sub.get('currentPeriodEnd', request.time) > request.time)
        );
    }

    function activePlanAtLeast(requiredPlan) {
      let plan = serviceSubscription().get('plan', '');
      return trustedActiveSubscription()
        && (
          requiredPlan == 'essential'
          || (requiredPlan == 'family' && plan in ['family', 'care'])
          || (requiredPlan == 'care' && plan == 'care')
        );
    }

    function caregiverLimit() {
      return serviceSubscription().get('plan', '') == 'essential' ? 1 : 5;
    }

    function historyAllowed(recordedAt) {
      // Family and Care have retained history, so their collection queries do
      // not need a per-document time predicate. Essential remains restricted
      // to records inside its seven-day window.
      return activePlanAtLeast('family')
        || (
          activePlanAtLeast('essential')
          && recordedAt is timestamp
          && recordedAt >= request.time - duration.value(7, 'd')
        );
    }

    function validUserAvatar() {
      return !('avatarUrl' in request.resource.data)
        || request.resource.data.avatarUrl == null
        || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.size() <= 2048);
    }

    function doesNotMutateServiceAuthority() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'subscription',
          'serviceOwnerUid',
          'memberUids',
          'familyMembers'
        ]);
    }

    function validNewUserAuthorityFields() {
      return !request.resource.data.keys()
          .hasAny(['subscription', 'serviceOwnerUid', 'memberUids'])
        && (
          !('familyMembers' in request.resource.data)
          || (request.resource.data.familyMembers is list
              && request.resource.data.familyMembers.size() == 0)
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validNewUserAuthorityFields();
      allow update: if signedIn()
        && request.auth.uid == uid
        && validUserAvatar()
        && doesNotMutateServiceAuthority();
      allow delete: if false;
    }

    // Backend-owned source of truth for Essential / Family / Care. The app
    // may display only its verified effective family plan. Admin SDK billing,
    // migration and support tools bypass these client rules for writes.
    match /serviceSubscriptions/{ownerUid} {
      allow read: if verifiedServiceMember(ownerUid);
      allow create, update, delete: if false;
    }

    match /devices/{imei} {
      allow read: if linkedTo(imei);
      // Gateway (Admin SDK) owns telemetry. Clients may identify the wearer,
      // set the wearable's SIM number (used for calls / SMS commands), and
      // cache the last fall-detection / location-reporting-interval
      // preference they asked the pendant for (V46/V48/V52 only -- the
      // device has no read-back command, so this is a request cache, not
      // confirmed device state; see commands.js).
      allow update: if linkedTo(imei)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'nickname',
              'relationship',
              'avatarUrl',
              'simNumber',
              'fallDetection',
              'locationReportingIntervalSeconds',
              'locationReportingMode',
              'careProfile',
              'carePriorities',
              'updatedAt'
            ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['careProfile', 'carePriorities'])
          || activePlanAtLeast('care')
        );
      allow create, delete: if false;

      match /locations/{locationId} {
        allow read: if linkedTo(imei)
          && historyAllowed(resource.data.recordedAt);
        allow write: if false;
      }

      match /segments/{segmentId} {
        allow read: if linkedTo(imei)
          && historyAllowed(resource.data.from);
        allow write: if false;
      }

      match /journeys/{journeyId} {
        allow read: if linkedTo(imei)
          && historyAllowed(resource.data.startAt);
        allow write: if false;

        match /presentations/{presentationId} {
          allow read: if linkedTo(imei)
            && historyAllowed(resource.data.journeyStartAt)
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time;
          allow write: if false;
        }
      }
    }

    match /geofences/{geofenceId} {
      allow read: if linkedTo(resource.data.imei);
      allow create: if signedIn()
        && linkedTo(request.resource.data.imei)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if linkedTo(resource.data.imei)
        && resource.data.createdBy == request.auth.uid;
    }

    match /medicationReminders/{reminderId} {
      allow read: if linkedTo(resource.data.imei)
        && activePlanAtLeast('care');
      allow create: if signedIn()
        && linkedTo(request.resource.data.imei)
        && activePlanAtLeast('care')
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if linkedTo(resource.data.imei)
        && activePlanAtLeast('care')
        && resource.data.createdBy == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow read: if linkedTo(resource.data.imei);
      allow update: if linkedTo(resource.data.imei)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'resolvedAt']);
      // App "Send help alert" â€” gateway still owns device-originated alerts.
      allow create: if linkedTo(request.resource.data.imei)
        && request.resource.data.type == 'sos'
        && request.resource.data.severity == 'critical'
        && request.resource.data.resolved == false
        && request.resource.data.notifyStatus == 'pending'
        && request.resource.data.keys()
            .hasOnly(['imei', 'type', 'severity', 'message', 'resolved',
                      'payload', 'createdAt', 'notifyStatus']);
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && effectiveServiceOwnerUid() == request.auth.uid
        && activePlanAtLeast('essential')
        && userDoc().get('memberUids', []).size() < caregiverLimit()
        && request.resource.data.keys().hasOnly([
          'code',
          'createdBy',
          'createdByName',
          'createdByEmail',
          'status',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code == inviteId
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Joining a family is a backend-verified workflow. The requester may only
    // enqueue the code. The gateway validates expiry, active plan and caregiver
    // capacity before it writes serviceOwnerUid, memberUids or linked watches.
    match /familyJoinRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'requestedBy',
          'status',
          'createdAt'
        ])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if linkedTo(resource.data.imei);
      allow write: if false; // gateway Admin SDK only
    }

    match /deviceCommands/{commandId} {
      allow read: if linkedTo(resource.data.imei);
      allow create: if linkedTo(request.resource.data.imei)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.get('type', '') != 'set_medication_reminder'
          || activePlanAtLeast('care')
        );
      allow update, delete: if false; // gateway Admin SDK only
    }
  }
}
