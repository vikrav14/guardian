# TCP
PORT=9000
HOST=0.0.0.0

# Firebase (leave FIRESTORE_DISABLED=true for local TCP-only testing)
FIRESTORE_DISABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Location history subcollection (route replay in the app). Default false for local dev;
# set true in production — the app route-history screen is empty without it.
WRITE_LOCATION_HISTORY=false

# ReachFar V28C IMEI normalization (10-digit protocol id → 15-digit label IMEI)
# IMEI_PREFIX=8613970
# IMEI_DEFAULT_SUFFIX=0
# IMEI_MAP=9705313987:861397053139877

# Emergency contact notifications (Twilio — optional)
# Without these, the gateway still logs notify attempts to notificationLogs/
NOTIFY_SMS=true
NOTIFY_WHATSAPP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
# e.g. whatsapp:+14155238886 for Twilio sandbox
TWILIO_WHATSAPP_FROM=

# HTTP webhook (WhatsApp AI assistant)
HTTP_PORT=9001

# Claude — required for conversational answers (without it, /dev/chat uses a simple fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
