# TCP
PORT=9000
HOST=0.0.0.0

# Firebase (leave FIRESTORE_DISABLED=true for local TCP-only testing)
FIRESTORE_DISABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Location history subcollection (legacy sparse trail). Default false — Journey replay uses
# compressed `devices/{imei}/journeys` instead. Set true only if you need raw location docs.
WRITE_LOCATION_HISTORY=false

# V52 steps and daily activity. Keep ingestion disabled and the counter mode
# unverified until the exact watch proves its midnight and reboot behaviour.
# The passive pipeline sends no device command. A technician may explicitly
# provision a new watch with `npm run activity:provision -- --imei ... --enable`.
ACTIVITY_STEPS_INGEST_ENABLED=false
# Independent customer-read gate for the app/WhatsApp surfaces.
ACTIVITY_STEPS_CUSTOMER_ENABLED=false
ACTIVITY_STEPS_COUNTER_MODE=unverified
ACTIVITY_STEPS_TIME_ZONE=Indian/Mauritius
ACTIVITY_STEPS_RETENTION_DAYS=90
ACTIVITY_STEPS_WRITE_MINUTES=15
ACTIVITY_STEPS_MAX_PER_MINUTE=300
ACTIVITY_STEPS_CLEANUP_MINUTES=360

# Event-driven write gate (Phase 0.5)
# WRITE_GATE_MIN_METRES=50
# WRITE_GATE_HEARTBEAT_MINUTES=5
# WRITE_GATE_HISTORY_MINUTES=5
# DWELL_MIN_MINUTES=10

# Journey builder — close active movement segment after this many minutes idle (default 15)
JOURNEY_IDLE_MINUTES=15

# V52 protocol-ID to hardware-IMEI normalization
# IMEI_PREFIX=your-7-digit-tac-prefix
# IMEI_DEFAULT_SUFFIX=your-suffix-digit
# IMEI_MAP=protocol-id:hardware-imei

# Emergency contact notifications. Carrier SMS is optional; WhatsApp is Meta only.
# Without SMS credentials, SMS is skipped and the result is still logged.
NOTIFY_SMS=true
NOTIFY_WHATSAPP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=

# Meta WhatsApp Cloud API
# Access token is SECRET. Put the real value only in gateway/.env / deployment secrets.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_GRAPH_VERSION=v25.0
# App Secret from Meta App Settings -> Basic. SECRET: never commit or paste in chat.
META_APP_SECRET=
# Random token you choose; use the same value in Meta's webhook verification form.
META_WHATSAPP_VERIFY_TOKEN=
# Fall alerts use the three fixed, approved templates documented in
# docs/WHATSAPP_ASSISTANT.md. Reminder body variables are wearer name,
# reminder text, and scheduled time.
META_WHATSAPP_REMINDER_TEMPLATE=

# HTTP webhook (WhatsApp AI assistant)
HTTP_PORT=9001

# Phase 1: LLM Provider Selection
# Set to 'gemini' (primary), 'anthropic' (fallback), or 'template' (offline mode)
# Auto-detection: tries Gemini if GEMINI_API_KEY set, else Anthropic if ANTHROPIC_API_KEY set, else template
LLM_PROVIDER=gemini

# Gemini Flash (primary provider for Phase 1+)
# Enable "Generative Language API" in Google Cloud Console
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (fallback provider)
# Required for conversational answers (without it, uses fallback template responses)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Geolocation API — resolves gps=V WiFi/LBS packets to lat/lng.
# Enable "Geolocation API" in Google Cloud Console (same project as Maps is fine).
GOOGLE_GEOLOCATION_API_KEY=

# Journey display enrichment (server-restricted keys only). Enable Roads API,
# Routes API and Places API (New). This never replaces stored GPS evidence.
JOURNEY_GOOGLE_PRESENTATION_ENABLED=true
GOOGLE_ROADS_API_KEY=
# May use the same restricted key as Roads when Routes API is enabled on it.
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=

# Current conditions used by the hourly context-intelligence sweep.
OPEN_WEATHER_MAP_KEY=

# Context intelligence is disabled by default and never sends WhatsApp.
CONTEXT_INTELLIGENCE_ENABLED=false
CONTEXT_POLL_MINUTES=60
CONTEXT_WEATHER_CACHE_MINUTES=60
CONTEXT_MAX_DEVICES_PER_SWEEP=1000
CONTEXT_CONCURRENCY=5
CONTEXT_RUN_ON_STARTUP=true
CONTEXT_LLM_JUDGMENT_ENABLED=true
CONTEXT_PERSIST_OBSERVATIONS=false

# Official Mauritius Meteorological Services CAP warnings. This is a separate
# five-minute source poll feeding the same observe-only context evaluator.
CONTEXT_CAP_ENABLED=false
CONTEXT_CAP_FEED_URL=https://cap-sources.s3.amazonaws.com/mu-mms-en/rss.xml
CONTEXT_CAP_POLL_MINUTES=5
CONTEXT_CAP_MAX_ITEMS=50
CONTEXT_CAP_RUN_ON_STARTUP=true
CONTEXT_CAP_EVALUATE_DEVICES=true
# Optional source-fact audit documents in contextEvents/{eventId}.
CONTEXT_CAP_PERSIST_EVENTS=false

# Defi Media local-news RSS. This phase remains observe-only: it polls every
# 15 minutes and writes only restart-safe source/match evidence. It performs
# deterministic matching but makes no LLM or automatic notification call.
CONTEXT_DEFIMEDIA_ENABLED=false
CONTEXT_DEFIMEDIA_FEED_URL=https://defimedia.info/rss.xml
CONTEXT_DEFIMEDIA_POLL_MINUTES=15
CONTEXT_DEFIMEDIA_MAX_ITEMS=100
CONTEXT_DEFIMEDIA_MAX_AGE_HOURS=24
CONTEXT_DEFIMEDIA_RUN_ON_STARTUP=true
CONTEXT_DEFIMEDIA_PERSIST_EVENTS=true
CONTEXT_DEFIMEDIA_EVALUATE_DEVICES=true
CONTEXT_DEFIMEDIA_PERSIST_MATCHES=true
CONTEXT_DEFIMEDIA_LOCATION_FRESH_MINUTES=15
CONTEXT_DEFIMEDIA_MAX_APPROX_ACCURACY_METERS=1000

# Command Center ops API (required in production — blocks /ops/* without it)
# ADMIN_API_KEY=your-long-random-secret
# Comma-separated Firebase Auth emails allowed admin UI (Phase 2 Firebase login)
# ADMIN_EMAILS=admin@example.com
# OPS_METRICS_FLUSH_MS=60000
