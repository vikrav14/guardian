# TCP
PORT=9000
HOST=0.0.0.0

# Firebase (leave FIRESTORE_DISABLED=true for local TCP-only testing)
FIRESTORE_DISABLED=true
# Per-wearer family access and bounded WhatsApp answers. Keep off until the
# coordinated rules/app/gateway rollout and reviewed service provisioning.
FAMILY_SHARING_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Safety snapshot — all gates remain off until exact V52 capture/transport acceptance.

# Location history subcollection (legacy sparse trail). Default false — Journey replay uses
# compressed `devices/{imei}/journeys` instead. Set true only if you need raw location docs.
WRITE_LOCATION_HISTORY=false
# Required persistent storage for GPS evidence, active journeys and write retries.
# Enabled independently of the optional location-history collection and Wi-Fi pilot.
JOURNEY_JOURNAL_ENABLED=true
# JOURNEY_JOURNAL_DIRECTORY=/persistent/guardian/journeys

# V52 steps and daily activity. The app shows recorded increases as
# explicitly labelled estimates. The passive pipeline sends no device command.
# observed_delta is intentional: the watch's midnight/reset semantics are not
# proven, so days remain partial and wearing is never inferred from steps.
ACTIVITY_STEPS_INGEST_ENABLED=true
# Independent customer-read gate for the app/WhatsApp surfaces.
ACTIVITY_STEPS_CUSTOMER_ENABLED=true
ACTIVITY_STEPS_COUNTER_MODE=observed_delta
# daily_reset requires proven device reset semantics and remains opt-in only.
ACTIVITY_STEPS_TIME_ZONE=Indian/Mauritius
ACTIVITY_STEPS_RETENTION_DAYS=90
ACTIVITY_STEPS_WRITE_MINUTES=15
ACTIVITY_STEPS_MAX_PER_MINUTE=300
ACTIVITY_STEPS_CLEANUP_MINUTES=360

# Event-driven write gate (Phase 0.5)
# WRITE_GATE_MIN_METRES=50
# WRITE_GATE_HEARTBEAT_MINUTES=5
# WRITE_GATE_HISTORY_MINUTES=5
# DWELL_MIN_MINUTES=10

# Journey builder — close active movement segment after this many minutes idle (default 15)
JOURNEY_IDLE_MINUTES=15

# V52 protocol-ID to hardware-IMEI normalization
# IMEI_PREFIX=your-7-digit-tac-prefix
# IMEI_DEFAULT_SUFFIX=your-suffix-digit
# IMEI_MAP=protocol-id:hardware-imei

# Emergency contact notifications. Carrier SMS is optional; WhatsApp is Meta only.
# Without SMS credentials, SMS is skipped and the result is still logged.
NOTIFY_SMS=true
NOTIFY_WHATSAPP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=

# Meta WhatsApp Cloud API
# Access token is SECRET. Put the real value only in gateway/.env / deployment secrets.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_GRAPH_VERSION=v25.0
# App Secret from Meta App Settings -> Basic. SECRET: never commit or paste in chat.
META_APP_SECRET=
# Random token you choose; use the same value in Meta's webhook verification form.
META_WHATSAPP_VERIFY_TOKEN=
# Fall alerts use the three fixed, approved templates documented in
# docs/WHATSAPP_ASSISTANT.md. Reminder body variables are wearer name,
# reminder text, and scheduled time.
META_WHATSAPP_REMINDER_TEMPLATE=
# Pilot-only SOS callback templates. Leave both empty until the three callback
# templates are Meta-approved for the same watch number and the V52 no-call
# alarm mode has passed the controlled acceptance test. Never commit real IDs
# or phone numbers here.
META_WHATSAPP_SOS_CALLBACK_PILOT_IMEI=
META_WHATSAPP_SOS_CALLBACK_PILOT_NUMBER=

# Versioned per-watch calling and incident-photo WhatsApp rollout.
# See docs/services/incident-photo-whatsapp-v3.md. No flag is enabled by
# template preview/submission. Keep existing approved templates selected until
# contracts, deployed call/gallery URLs and a coordinated test are verified.
WATCH_CALL_PUBLIC_ORIGIN=
META_WHATSAPP_SOS_DYNAMIC_CALL_ENABLED=false
META_WHATSAPP_FALL_DYNAMIC_CALL_ENABLED=false
INCIDENT_PHOTO_SOS_V3_ENABLED=false
INCIDENT_PHOTO_FALL_V3_ENABLED=false
INCIDENT_PHOTO_FOLLOWUP_APPROVED=false
# One automatic photo + explicit guardian requests for the original hour.
# Requires all seven v5/photo-v3 contracts approved as Utility; no automatic activation.
INCIDENT_PHOTO_GUARDIAN_WINDOW_APPROVED=false
INCIDENT_PHOTOS_APP_URL=
# INCIDENT_PHOTO_TEMPLATES_APPROVED is retired; it no longer selects templates.

# Private router observation: off by default, never enables the customer Home pin.
# Prefer `npm run wifi-home:setup`; it writes a private managed block without
# printing identifiers or keys. Keep these commented if using that setup:
# WIFI_HOME_OBSERVE_ENABLED=false
# WIFI_HOME_PILOT_IMEI=
# WIFI_HOME_ROUTER_HASH=
# WIFI_HOME_HASH_KEY=
# Optional private Home map / ordinary location-reply pilot after router matching.
# WIFI_HOME_DISPLAY_PILOT_ENABLED=false
# Unaccepted walk-recovery experiment. Leave off for the Home display pilot.
# Requires the observer/display pilot above; setup does not enable this flag.
# WIFI_HOME_WALK_RECOVERY_EXPERIMENT_ENABLED=false

# Care routines/accessibility reminders: customer and automatic device sync stay off.
# Operator-only clock trials use a separate explicit CLI; no scheduled dispatch.
CARE_REMINDERS_REQUESTS_ENABLED=false
CARE_REMINDERS_DEVICE_MODE=unverified
CARE_REMINDERS_CUSTOMER_ENABLED=false

# HTTP webhook (WhatsApp AI assistant)
HTTP_PORT=9001

# Shared metered LLM provider (qualify the chosen model before enabling)
# Set explicitly to 'gemini', 'anthropic', or 'template' (no paid model). No automatic generation retry.
# Auto-detection: tries Gemini if GEMINI_API_KEY set, else Anthropic if ANTHROPIC_API_KEY set, else template
LLM_PROVIDER=gemini

# Gemini Flash (primary provider for Phase 1+)
# Enable "Generative Language API" in Google Cloud Console
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic Claude (alternative provider and existing photo pipeline)
# Required for conversational answers (without it, uses fallback template responses)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Geolocation API — resolves gps=V WiFi/LBS packets to lat/lng.
# Enable "Geolocation API" in Google Cloud Console (same project as Maps is fine).
GOOGLE_GEOLOCATION_API_KEY=

# Journey display enrichment (server-restricted keys only). Enable Roads API,
# Routes API and Places API (New). This never replaces stored GPS evidence.
JOURNEY_GOOGLE_PRESENTATION_ENABLED=true
GOOGLE_ROADS_API_KEY=
# May use the same restricted key as Roads when Routes API is enabled on it.
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=

# Current conditions used by the hourly context-intelligence sweep.
OPEN_WEATHER_MAP_KEY=

# Context intelligence is disabled by default and never sends WhatsApp.
CONTEXT_INTELLIGENCE_ENABLED=false
CONTEXT_POLL_MINUTES=60
CONTEXT_WEATHER_CACHE_MINUTES=60
CONTEXT_MAX_DEVICES_PER_SWEEP=1000
CONTEXT_CONCURRENCY=5
CONTEXT_RUN_ON_STARTUP=true
CONTEXT_LLM_JUDGMENT_ENABLED=true
CONTEXT_PERSIST_OBSERVATIONS=false

# Official Mauritius Meteorological Services CAP warnings. This is a separate
# five-minute source poll feeding the same observe-only context evaluator.
CONTEXT_CAP_ENABLED=false
# Dashboard display only. No WhatsApp, push, or watch commands.
# Enable source flags as well; optional pilot IMEIs are comma-separated.
PRIORITY_UPDATES_ENABLED=false
PRIORITY_UPDATES_IMEIS=
CONTEXT_CAP_FEED_URL=https://cap-sources.s3.amazonaws.com/mu-mms-en/rss.xml
CONTEXT_CAP_POLL_MINUTES=5
CONTEXT_CAP_MAX_ITEMS=50
CONTEXT_CAP_RUN_ON_STARTUP=true
CONTEXT_CAP_EVALUATE_DEVICES=true
# Optional source-fact audit documents in contextEvents/{eventId}.
CONTEXT_CAP_PERSIST_EVENTS=false

# Defi Media local-news RSS. This phase remains observe-only: it polls every
# 15 minutes and writes only restart-safe source/match evidence. It performs
# deterministic matching but makes no LLM or automatic notification call.
CONTEXT_DEFIMEDIA_ENABLED=false
CONTEXT_DEFIMEDIA_FEED_URL=https://defimedia.info/rss.xml
CONTEXT_DEFIMEDIA_POLL_MINUTES=15
CONTEXT_DEFIMEDIA_MAX_ITEMS=100
CONTEXT_DEFIMEDIA_MAX_AGE_HOURS=24
CONTEXT_DEFIMEDIA_RUN_ON_STARTUP=true
CONTEXT_DEFIMEDIA_PERSIST_EVENTS=true
CONTEXT_DEFIMEDIA_EVALUATE_DEVICES=true
CONTEXT_DEFIMEDIA_PERSIST_MATCHES=true
CONTEXT_DEFIMEDIA_LOCATION_FRESH_MINUTES=15
CONTEXT_DEFIMEDIA_MAX_APPROX_ACCURACY_METERS=1000

# Command Center ops API (required in production — blocks /ops/* without it)
# ADMIN_API_KEY=your-long-random-secret
# Comma-separated Firebase Auth emails allowed admin UI (Phase 2 Firebase login)
# ADMIN_EMAILS=admin@example.com
# OPS_METRICS_FLUSH_MS=60000

# V52 Care wellbeing readings (all fail-closed until real-device acceptance).
# Persistence additionally requires a backend-owned wellbeingConsents/{imei}
# record with explicit wearer acknowledgement.
CARE_WELLBEING_INGEST_ENABLED=false
CARE_WELLBEING_DEVICE_MODE=unverified
CARE_WELLBEING_CUSTOMER_ENABLED=false
CARE_WELLBEING_REQUEST_ENABLED=false
CARE_WELLBEING_RETENTION_DAYS=30
WELLNESS_ROUTINE_ENABLED=false

# One-photo TCP path. Enable only exact devices accepted for the operator trial.
# Existing photos remain inaccessible without authenticated current family access.
SAFETY_SNAPSHOT_REQUESTS_ENABLED=false
SAFETY_SNAPSHOT_CUSTOMER_ENABLED=false
SAFETY_SNAPSHOT_MEDIA_INGRESS_ENABLED=false
SAFETY_SNAPSHOT_DEVICE_MODE=unverified
SAFETY_SNAPSHOT_ACCEPTED_IMEIS=
FIREBASE_STORAGE_BUCKET=

# Supervised movement reminder app trial only. Never send on startup.
# Prefer scripts/start-movement-reminder-pilot.js for a temporary process scope.
MOVEMENT_REMINDER_PILOT_ENABLED=false
MOVEMENT_REMINDER_PILOT_IMEI=
MOVEMENT_REMINDER_PILOT_UID=

# Guardian app: Home Wi-Fi enrollment from recent watch reports.
# Passive only; sends no scan/location/reporting/fence commands. See docs/services/home-wifi-setup.md.
WIFI_HOME_SETUP_ENABLED=false

# Ordinary recorded voice messages: exact-device/account pilot only.
# See docs/services/voice-chat-app.md before enabling a hardware trial.
VOICE_MESSAGES_ENABLED=false
VOICE_MESSAGES_PILOT_IMEI=
VOICE_MESSAGES_PILOT_UID=

# Guardian Intelligence app/API is opt-in; all provider calls use the common ledger.
GUARDIAN_INTELLIGENCE_ENABLED=false
# Fixed planning conversion and internal monthly AI operating budgets.
AI_BUDGET_MUR_PER_USD=50
AI_FAMILY_MONTHLY_MUR=50
AI_CARE_MONTHLY_MUR=100
AI_FLEET_MONTHLY_MUR=15000
AI_BACKGROUND_MONTHLY_MUR=1000
